digraph causality {
  rankdir=TB; nodesep=0.25; ranksep=0.45;
  newrank=true;
  graph [fontname="Helvetica", fontsize=12];
  node [shape=box, fontname="Helvetica", fontsize=11, margin="0.12,0.04"];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.7];
  label="herstory.llp · key 3e873a6f57bd · stage (done) · 23 fired\nsolid, atom: token flow (made, then spent)  ·  dashed, $atom: read (needed, kept)  ·  dotted: order (competition, stage)  ·  bold: frontier  ·  diamond: stage switch";
  labelloc=t;
  node [shape=plaintext, fontcolor=gray40] b0 [label="beat 0"]; b1 [label="beat 1"]; b2 [label="beat 2"]; b3 [label="beat 3"]; b4 [label="beat 4"]; b5 [label="beat 5"]; b6 [label="beat 6"]; b7 [label="beat 7"]; b8 [label="beat 8"]; b9 [label="beat 9"]; b10 [label="beat 10"]; b11 [label="beat 11"]; b12 [label="beat 12"]; b13 [label="beat 13"]; b14 [label="beat 14"]; b15 [label="beat 15"]; b16 [label="beat 16"]; b17 [label="beat 17"]; b18 [label="beat 18"]; b19 [label="beat 19"];
  b0 -> b1 -> b2 -> b3 -> b4 -> b5 -> b6 -> b7 -> b8 -> b9 -> b10 -> b11 -> b12 -> b13 -> b14 -> b15 -> b16 -> b17 -> b18 -> b19 [style=invis];
  node [shape=box, fontcolor=black];
  subgraph cluster_e0 {
    label="stage beginning · episode 0";
    labeljust=l; style=filled; fillcolor=gray96; color=gray80; fontcolor=gray30;
    n0 [label="0 #init", shape=ellipse];
